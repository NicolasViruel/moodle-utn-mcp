{
  "name": "moodle-utn-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only Moodle profile access through a user-operated browser session over MCP stdio.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && node dist/index.js",
    "smoke": "npm run build && node dist/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright": "1.58.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
