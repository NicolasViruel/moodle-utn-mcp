# Copiá este archivo a .env y completá los valores.
# El .env NUNCA se sube al repositorio (está en .gitignore).

# Origen exacto del campus Moodle (sin path ni barra final).
MOODLE_REST_ORIGIN=https://tup.sied.utn.edu.ar

# Tu token personal de Moodle Web Services. Se obtiene con PowerShell:
#
#   $body = @{
#     username = "TU_DNI"   # solo el DNI, no el email de Quinttos
#     password = "TU_CONTRASENA_MOODLE"
#     service  = "moodle_mobile_app"
#   }
#   Invoke-RestMethod -Uri "https://tup.sied.utn.edu.ar/login/token.php" -Method Post -Body $body
#
# Devuelve { token: "..." } — pegá ese valor en .env (no en este archivo).
#
# ATENCIÓN: este token equivale a tu contraseña. Quien lo tenga puede
# actuar en tu nombre en el campus. No lo compartas ni lo subas a Git.
MOODLE_REST_TOKEN=